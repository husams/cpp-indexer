      "excludePaths": ["src/astgraph/main.cpp"],
      "allowedDependencies": [
        "analysis.astgraph",
        "extraction.ast",
        "frontend.compiledb",
        "workspace.toolchain",
        "model.contracts",
        "foundation.util",
        "persistence.sqlite"
      ],
      "allowedExternal": ["clang", "llvm"],
      "description": "Raw-AST artifact extraction and Soufflé analysis adapter."
