        "extraction.ast",
        "model.contracts",
        "foundation.util",
        "frontend.compiledb",
        "workspace.toolchain"
      ],
      "allowedExternal": ["clang", "llvm"],
      "description": "Typed LibTooling visitors, identity encoders, and extraction ports/adapters."
    },
    {
      "id": "analysis.astgraph",
      "layer": "analysis",
