      "description": "Small platform utilities; filesystem and process access live here."
    },
    {
      "id": "workspace.toolchain",
      "layer": "workspace",
      "paths": ["src/toolchain/**", "src/workspace/**"],
      "allowedDependencies": [
        "workspace.toolchain",
        "foundation.util",
        "model.contracts",
        "frontend.compiledb",
        "persistence.sqlite"
      ],
      "description": "Compiler, driver, resource-directory, workspace snapshots, and shared translation-unit resolution."
    },
    {
      "id": "frontend.compiledb",
      "layer": "frontend",
      "paths": ["src/compiledb/**"],
      "allowedDependencies": [
        "frontend.compiledb",
        "foundation.util",
        "model.contracts"
      ],
      "allowedExternal": ["clang", "llvm"],
      "description": "Clang compilation-database adapter."
    },
    {
      "id": "extraction.ast",
      "layer": "extraction",
