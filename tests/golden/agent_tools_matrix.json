      "surfaces": ["cpp", "python", "cli"],
      "expected_status": null,
      "expected_truncated": false,
      "expected_budget": null,
      "expected_shape": "nodes",
      "expected_count": null,
      "expected_result_keys": ["plan", "budgets"],
      "expected_diagnostics": [],
      "expected_row_file_null": false,
      "cli_mode": "explain"
    },
    {
      "id": "empty_result",
      "tool": "query",
      "cxq": "symbol(\"missing\")",
      "max_results": 10,
      "surfaces": ["cpp", "python", "cli"],
      "expected_status": null,
      "expected_truncated": false,
      "expected_budget": null,
      "expected_shape": "nodes",
      "expected_count": 0,
      "expected_result_keys": ["rows", "shape", "count"],
      "expected_diagnostics": [],
      "expected_row_file_null": false,
      "cli_mode": "query"
    },
    {
      "id": "null_provenance",
      "tool": "query",
      "cxq": "codebase() | nodes() | select(name, file, line)",
      "max_results": 10,
      "surfaces": ["cpp", "python", "cli"],
      "expected_status": null,
      "expected_truncated": false,
      "expected_budget": null,
      "expected_shape": "rows",
      "expected_count": 2,
      "expected_result_keys": ["rows", "shape", "count"],
      "expected_diagnostics": ["missing_evidence"],
      "expected_row_file_null": true,
      "cli_mode": "query"
    },
    {
      "id": "query_limit",
      "tool": "query",
      "cxq": "codebase() | nodes() | limit(1)",
      "max_results": 1000,
      "surfaces": ["cpp", "python", "cli"],
      "expected_status": null,
      "expected_truncated": false,
      "expected_budget": null,
      "expected_shape": "nodes",
      "expected_count": 1,
      "expected_result_keys": ["rows", "shape", "count"],
      "expected_diagnostics": ["missing_evidence"],
      "expected_row_file_null": false,
      "cli_mode": "query",
      "forbidden_diagnostics": ["truncated_budget"]
    },
    {
      "id": "truncated_budget",
      "tool": "query",
      "cxq": "codebase() | nodes() | select(name, file, line)",
      "max_results": 1,
      "surfaces": ["cpp", "python"],
      "expected_status": "partial",
      "expected_truncated": true,
      "expected_budget": 1,
      "expected_shape": "rows",
      "expected_count": 1,
      "expected_result_keys": ["rows", "shape", "count"],
      "expected_diagnostics": ["truncated_budget", "missing_evidence"],
      "expected_row_file_null": true,
      "cli_mode": "query"
    },
    {
      "id": "rejected_cxq",
      "tool": "query",
      "cxq": "codebase() | nodes() | nope()",
      "max_results": 10,
      "surfaces": ["cpp", "python", "cli"],
      "expected_status": "error",
      "expected_truncated": false,
      "expected_budget": null,
      "expected_shape": null,
      "expected_count": null,
      "expected_result_keys": [],
      "expected_diagnostics": ["invalid_input"],
      "expected_row_file_null": false,
      "cli_mode": "query",
      "cli_error": "E_PARSE: unknown stage 'nope()'"
    }
  ]
