// events.def — X-macro definition file for AC-M5-4 boundary test.
//
// Provides exactly 20 HANDLE_EVENT entries.  Callers define HANDLE_EVENT,
// include this file, then undef.  Each inclusion generates 20 top-level macro
// expansions; the AC-M5-4 bound is: total EXPANDS_TO edges ≤ 10 × L where L
// is the source line count of the TU under test (main.cpp = 38 lines → ≤ 380).
//
// No system headers — all symbols are self-contained.

HANDLE_EVENT(Click,      1)
HANDLE_EVENT(KeyDown,    2)
HANDLE_EVENT(KeyUp,      3)
HANDLE_EVENT(MouseMove,  4)
HANDLE_EVENT(Resize,     5)
HANDLE_EVENT(Focus,      6)
HANDLE_EVENT(Blur,       7)
HANDLE_EVENT(Scroll,     8)
HANDLE_EVENT(Touch,      9)
HANDLE_EVENT(DragStart, 10)
HANDLE_EVENT(DragEnd,   11)
HANDLE_EVENT(Drop,      12)
HANDLE_EVENT(ContextMenu,13)
HANDLE_EVENT(DblClick,  14)
HANDLE_EVENT(WheelUp,   15)
HANDLE_EVENT(WheelDown, 16)
HANDLE_EVENT(Enter,     17)
HANDLE_EVENT(Leave,     18)
HANDLE_EVENT(Select,    19)
HANDLE_EVENT(Change,    20)
