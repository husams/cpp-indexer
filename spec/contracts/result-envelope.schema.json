      "properties": {
        "workspace": {
          "type": "string",
          "x-maxUtf8Bytes": 4096,
          "minLength": 1,
          "not": {
            "enum": [
              "",
              "unknown",
              "workspace:unknown",
              "workspace://unknown",
              "index:unknown",
              "index://unknown"
            ]
          }
        },
        "index": {
          "type": "string",
          "x-maxUtf8Bytes": 4096,
          "minLength": 1,
          "not": {
            "enum": [
              "",
              "unknown",
              "workspace:unknown",
              "workspace://unknown",
              "index:unknown",
              "index://unknown"
            ]
          }
        },
        "fact_sets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "x-maxUtf8Bytes": 4096
          }
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unverifiable"
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "x-maxUtf8Bytes": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "source_fingerprint": {
          "anyOf": [
            {
              "type": "string",
