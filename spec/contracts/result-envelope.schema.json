  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "cidx.result/v1"
    },
    "operation": {
      "type": "string",
      "x-maxUtf8Bytes": 4096,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unknown",
        "refuted",
        "conditional",
        "error"
      ]
    },
    "exit_class": {
      "enum": [
        "success",
        "usage",
        "invalid_or_stale_input",
        "policy_failure",
        "unknown",
        "infrastructure_failure"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "result": {
