  "title": "CIDX result envelope v1",
  "type": "object",
  "required": [
    "protocol",
    "operation",
    "status",
    "exit_class",
    "exit_code",
    "result",
    "identity",
    "producer",
    "completeness",
    "diagnostics",
    "evidence",
    "artifacts"
  ],
  "additionalProperties": false,
  "properties": {
    "protocol": {
      "const": "cidx.result/v1"
    },
    "operation": {
      "type": "string",
      "maxLength": 4096,
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unknown",
        "refuted",
        "conditional",
        "error"
      ]
    },
    "exit_class": {
      "enum": [
        "success",
        "usage",
        "invalid_or_stale_input",
        "policy_failure",
        "unknown",
        "infrastructure_failure"
      ]
    },
    "exit_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "result": {
      "type": "object",
      "maxProperties": 64,
      "additionalProperties": {
        "$ref": "#/$defs/value0"
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "workspace",
        "index",
        "fact_sets",
        "freshness",
        "source_revision",
        "source_fingerprint"
      ],
      "additionalProperties": false,
      "properties": {
        "workspace": {
          "type": "string",
          "maxLength": 4096
        },
        "index": {
          "type": "string",
          "maxLength": 4096
        },
        "fact_sets": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "freshness": {
          "enum": [
            "current",
            "stale",
            "unverifiable"
          ]
        },
        "source_revision": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        },
        "source_fingerprint": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 4096
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "producer": {
      "type": "object",
      "required": [
        "package",
        "version",
        "backend",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "package": {
          "type": "string",
          "maxLength": 4096
        },
        "version": {
          "type": "string",
          "maxLength": 4096
        },
        "backend": {
          "type": "string",
          "maxLength": 4096
        },
        "schema_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "state",
        "truncated",
        "stale",
        "budget"
      ],
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "complete",
            "partial",
            "unknown"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "stale": {
          "type": "boolean"
        },
        "budget": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "usage",
              "invalid_input",
              "stale_input",
              "timeout",
              "backend_error",
              "policy_refuted",
              "unknown",
              "truncated_budget",
              "missing_evidence"
            ]
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string",
            "maxLength": 4096
          },
          "next_action": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/evidence0"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "schema_version",
          "catalog_version",
          "catalog_hash"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "semantic-index",
              "query-result",
              "analysis",
              "diff",
              "refactoring-plan",
              "proof"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 4096
          },
          "schema_version": {
            "type": "integer",
            "minimum": 1
          },
          "catalog_version": {
            "type": "integer",
            "minimum": 1
          },
          "catalog_hash": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "replay": {
      "type": "object",
      "required": [
        "command",
        "arguments"
      ],
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string",
          "maxLength": 4096
        },
        "arguments": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "string",
            "maxLength": 4096
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "elapsed_ms",
        "peak_bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "elapsed_ms": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "peak_bytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
