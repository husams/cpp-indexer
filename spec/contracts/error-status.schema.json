{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIDX stable error reduction",
  "type": "object",
  "required": ["status", "code", "message", "exit_class", "exit_code"],
  "additionalProperties": false,
  "properties": {
    "status": {"const": "error"},
    "code": {"enum": ["usage", "invalid_input", "stale_input", "backend_error", "timeout", "policy_refuted", "unknown"]},
    "message": {"type": "string"},
    "exit_class": {"enum": ["usage", "invalid_or_stale_input", "policy_failure", "unknown", "infrastructure_failure"]},
    "exit_code": {"type": "integer", "minimum": 1}
  }
}
