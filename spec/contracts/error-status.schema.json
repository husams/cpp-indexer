{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["status"],
  "properties": {
    "status": {"enum": ["ok", "partial", "truncated", "error"]},
    "code": {"type": "string", "pattern": "^E_[A-Z0-9_]+$"},
    "message": {"type": "string"}
  },
  "additionalProperties": false
}
