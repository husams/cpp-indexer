{
  "format": "cidx.result-protocol/v1",
  "protocol_version": 1,
  "numeric": {
    "min_integer": -9223372036854775808,
    "max_integer": 9223372036854775807
  },
  "limits": {
    "max_evidence_depth": 4,
    "max_evidence_nodes": 256,
    "max_text_bytes": 4096,
    "max_human_output_bytes": 4096,
    "max_result_depth": 8,
    "max_result_properties": 64,
    "max_result_items": 256,
    "max_diagnostics": 64,
    "max_evidence": 256,
    "max_artifacts": 64,
    "max_fact_sets": 32,
    "max_replay_arguments": 256
  },
  "statuses": ["complete", "partial", "unknown", "refuted", "conditional", "error"],
  "placeholder_identities": ["", "unknown", "workspace:unknown", "workspace://unknown", "index:unknown", "index://unknown"],
  "exit_classes": [
    {"name": "success", "code": 0},
    {"name": "usage", "code": 2},
    {"name": "invalid_or_stale_input", "code": 3},
    {"name": "policy_failure", "code": 4},
    {"name": "unknown", "code": 5},
    {"name": "infrastructure_failure", "code": 6}
  ],
  "freshness": ["current", "stale", "unverifiable"],
  "completeness_states": ["complete", "partial", "unknown"],
  "truncated_statuses": ["partial", "error"],
  "diagnostic_severities": ["info", "warning", "error"],
  "evidence_classes": ["source", "derived", "inferred", "runtime", "assumption", "proof"],
  "trust_levels": ["unverified", "producer-verified", "reader-verified"],
  "event_kinds": ["progress", "diagnostic", "completed"],
  "diagnostic_codes": [
    "usage", "invalid_input", "stale_input", "timeout", "backend_error",
    "policy_refuted", "unknown", "truncated_budget", "missing_evidence"
  ],
  "artifact_kinds": ["semantic-index", "query-result", "analysis", "diff", "refactoring-plan", "proof"],
  "diagnostic_invariants": [
    {"codes": ["stale_input"], "status": ["unknown"], "freshness": ["stale"]},
    {"codes": ["backend_error", "timeout"], "status": ["error"]},
    {"codes": ["policy_refuted"], "status": ["refuted"]}
  ],
  "diagnostic_status_invariants": [
    {"status": "complete", "required_any": [], "forbidden": ["usage", "invalid_input", "stale_input", "timeout", "backend_error", "policy_refuted", "unknown", "truncated_budget", "missing_evidence"]},
    {"status": "partial", "required_any": [], "forbidden": ["usage", "invalid_input", "stale_input", "timeout", "backend_error", "policy_refuted", "unknown"]},
    {"status": "unknown", "required_any": ["stale_input", "unknown", "missing_evidence"], "forbidden": ["usage", "invalid_input", "timeout", "backend_error", "policy_refuted", "truncated_budget"]},
    {"status": "conditional", "required_any": ["unknown", "missing_evidence"], "forbidden": ["usage", "invalid_input", "stale_input", "timeout", "backend_error", "policy_refuted", "truncated_budget"]},
    {"status": "refuted", "required_any": ["policy_refuted"], "forbidden": ["usage", "invalid_input", "stale_input", "timeout", "backend_error", "unknown", "truncated_budget", "missing_evidence"]},
    {"status": "error", "required_any": ["usage", "invalid_input", "timeout", "backend_error"], "forbidden": ["stale_input", "policy_refuted", "unknown", "truncated_budget", "missing_evidence"]}
  ],
  "adversarial_vectors": {
    "oversized_ascii_bytes": 4097,
    "oversized_multibyte_chars": 1025
  },
  "exit_reason_precedence": [
    {"code": "usage", "class": "usage", "exit_code": 2},
    {"code": "invalid_input", "class": "invalid_or_stale_input", "exit_code": 3},
    {"code": "stale_input", "class": "invalid_or_stale_input", "exit_code": 3},
    {"code": "policy_refuted", "class": "policy_failure", "exit_code": 4},
    {"code": "timeout", "class": "infrastructure_failure", "exit_code": 6},
    {"code": "backend_error", "class": "infrastructure_failure", "exit_code": 6},
    {"code": "unknown", "class": "unknown", "exit_code": 5}
  ],
  "acceptance_vectors": [
    {"name": "complete-query", "operation": "query", "status": "complete", "state": "complete", "freshness": "current", "diagnostic": null, "exit_class": "success", "exit_code": 0},
    {"name": "truncated-path", "operation": "query", "status": "partial", "state": "partial", "freshness": "current", "diagnostic": "truncated_budget", "exit_class": "success", "exit_code": 0},
    {"name": "stale-index", "operation": "query", "status": "unknown", "state": "unknown", "freshness": "stale", "diagnostic": "stale_input", "exit_class": "invalid_or_stale_input", "exit_code": 3},
    {"name": "partial-custom-analysis", "operation": "analysis", "status": "partial", "state": "partial", "freshness": "current", "diagnostic": "missing_evidence", "exit_class": "success", "exit_code": 0},
    {"name": "diff", "operation": "diff", "status": "complete", "state": "complete", "freshness": "current", "diagnostic": null, "exit_class": "success", "exit_code": 0},
    {"name": "refactoring-plan", "operation": "refactoring", "status": "conditional", "state": "unknown", "freshness": "current", "diagnostic": "unknown", "exit_class": "unknown", "exit_code": 5},
    {"name": "refuted-proof", "operation": "proof", "status": "refuted", "state": "unknown", "freshness": "current", "diagnostic": "policy_refuted", "exit_class": "policy_failure", "exit_code": 4},
    {"name": "infrastructure-error", "operation": "index", "status": "error", "state": "unknown", "freshness": "unverifiable", "diagnostic": "backend_error", "exit_class": "infrastructure_failure", "exit_code": 6}
  ],
  "goldens": {
    "result-envelope": {
      "protocol": "cidx.result/v1",
      "operation": "query",
      "status": "complete",
      "exit_class": "success",
      "exit_code": 0,
      "result": {"shape": "rows", "view": "symbol", "count": 1, "truncated": false, "rows": [{"id": 42, "name": "main", "kind": "function"}]},
      "identity": {"workspace": "workspace://demo", "index": "semantic-index://demo", "fact_sets": ["symbols", "files"], "freshness": "current", "source_revision": "git:abc123", "source_fingerprint": "sha256:source"},
      "producer": {"package": "cidx", "version": "0.53.0", "backend": "cpp", "schema_version": 1},
      "completeness": {"state": "complete", "truncated": false, "stale": false, "budget": null},
      "diagnostics": [],
      "evidence": [{"id": "queryplan", "class": "derived", "trust": "producer-verified", "summary": "bounded QueryPlan execution", "source": "query://demo"}],
      "artifacts": [{"kind": "query-result", "id": "query-result://demo", "schema_version": 1, "catalog_version": 1, "catalog_hash": "sha256:catalog"}]
    },
    "error-truncated-envelope": {
      "protocol": "cidx.result/v1",
      "operation": "index",
      "status": "error",
      "exit_class": "infrastructure_failure",
      "exit_code": 6,
      "result": {"indexed": 0, "failed": 1, "already": 0, "files": []},
      "identity": {"workspace": "workspace://demo", "index": "semantic-index://demo", "fact_sets": ["symbols", "files"], "freshness": "current", "source_revision": "git:abc123", "source_fingerprint": "sha256:source"},
      "producer": {"package": "cidx", "version": "0.53.0", "backend": "cpp", "schema_version": 1},
      "completeness": {"state": "unknown", "truncated": true, "stale": false, "budget": 1},
      "diagnostics": [{"code": "backend_error", "severity": "error", "message": "index operation failed"}],
      "evidence": [],
      "artifacts": []
    },
    "event": {"protocol": "cidx.event/v1", "sequence": 3, "operation": "index", "event": "progress", "message": "indexed 2 of 4 files", "completed": 2, "total": 4},
    "error-status": {"status": "error", "code": "backend_error", "message": "backend unavailable", "exit_class": "infrastructure_failure", "exit_code": 6}
  }
}
