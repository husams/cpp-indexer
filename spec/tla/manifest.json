{
  "specVersion": "1.1.0",
  "normativeBoundary": "The checked-in TLA+ modules, model configurations, protected predicates, and trusted-assumption register define observable CIDX behavior independently of implementation structure.",
  "modules": [
    "modules/CidxTypes.tla",
    "modules/CidxRepository.tla",
    "modules/CidxResult.tla",
    "modules/CidxStorageLifecycle.tla",
    "modules/CidxBehavior.tla",
    "modules/CidxWorkspaceLifecycle.tla",
    "modules/CidxSemanticGraph.tla",
    "conformance/CidxConformance.tla",
    "protected/CidxProtected.tla"
  ],
  "models": [
    {
      "module": "models/CidxRepositorySmoke.tla",
      "config": "models/CidxRepositorySmoke.cfg",
      "invariants": ["TypeInvariant", "RepositoryStructureInvariant", "SharedStatusInvariant", "ProtectedInvariant"]
    },
    {
      "module": "models/CidxResultSmoke.tla",
      "config": "models/CidxResultSmoke.cfg",
      "invariants": ["SharedResultTypeInvariant", "SharedStatusInvariant", "TrustedOutcomeInvariant"]
    },
    {
      "module": "models/CidxBehaviorSmoke.tla",
      "config": "models/CidxBehaviorSmoke.cfg",
      "invariants": [
        "TypeInvariant",
        "NoPartialGenerationInvariant",
        "AtomicPublicationInvariant",
        "InvalidationInvariant",
        "FailureHonestyInvariant",
        "QueryHonestyInvariant",
        "MigrationInvariant",
        "IdentityInvariant",
        "GraphInvariant",
        "QueryPlanInvariant",
        "IncludeHygieneInvariant",
        "TraceInvariant",
        "BoundedProgressInvariant",
        "ProtectedInvariant"
      ]
    },
    {
      "module": "models/CidxSemanticGraphSmoke.tla",
      "config": "models/CidxSemanticGraphSmoke.cfg",
      "invariants": [
        "TypeInvariant",
        "GraphNodeInvariant",
        "GraphRelationInvariant",
        "EvidenceOwnershipInvariant",
        "UnknownTargetInvariant",
        "PlanTransitionInvariant",
        "SetSemanticsInvariant",
        "WitnessInvariant",
        "CompletenessInvariant",
        "ReadOnlyExecutionInvariant",
        "TransformPublicationInvariant",
        "TransformConsumptionInvariant",
        "CycleAdversarialInvariant",
        "DiamondAdversarialInvariant",
        "FanoutAdversarialInvariant",
        "IncompleteTargetAdversarialInvariant",
        "PartialEvidenceAdversarialInvariant",
        "RecoveryTraceInvariant",
        "RecoveryFailureHonestyInvariant"
      ]
    },
    {
      "module": "models/CidxStorageLifecycleSmoke.tla",
      "config": "models/CidxStorageLifecycleSmoke.cfg",
      "invariants": [
        "TypeInvariant",
        "CurrentGenerationInvariant",
        "NoInvalidCurrentInvariant",
        "ReadOnlyStateInvariant",
        "MigrationInvariant",
        "SidecarInvariant",
        "CrossFileAtomicityInvariant",
        "CleanupSafetyInvariant",
        "PackageInvariant",
        "IncludeHygieneInvariant",
        "PublicationRecoveryInvariant",
        "TraceInvariant",
        "BoundedProgressInvariant"
      ],
      "properties": ["StorageEventuallySettles"]
    }
  ],
  "coverage": {
    "workspace-and-identity": {
      "modules": ["CidxRepository", "CidxBehavior"],
      "invariants": ["TypeInvariant", "RepositoryStructureInvariant", "IdentityInvariant"]
    },
    "index-and-generation-lifecycle": {
      "modules": ["CidxBehavior"],
      "invariants": ["NoPartialGenerationInvariant", "AtomicPublicationInvariant", "InvalidationInvariant"]
    },
    "semantic-graph": {
      "modules": ["CidxTypes", "CidxSemanticGraph"],
      "invariants": ["GraphNodeInvariant", "GraphRelationInvariant", "EvidenceOwnershipInvariant", "UnknownTargetInvariant", "CycleAdversarialInvariant", "DiamondAdversarialInvariant", "FanoutAdversarialInvariant", "IncompleteTargetAdversarialInvariant", "PartialEvidenceAdversarialInvariant"],
      "coverage": "smoke-bounded"
    },
    "query-plan-and-cxq": {
      "modules": ["CidxSemanticGraph", "CidxResult"],
      "invariants": ["PlanTransitionInvariant", "SetSemanticsInvariant", "WitnessInvariant", "CompletenessInvariant", "ReadOnlyExecutionInvariant"],
      "coverage": "smoke-bounded"
    },
    "storage-sidecars-and-migrations": {
      "modules": ["CidxStorageLifecycle", "CidxBehavior"],
      "invariants": [
        "CurrentGenerationInvariant",
        "NoInvalidCurrentInvariant",
        "ReadOnlyStateInvariant",
        "MigrationInvariant",
        "SidecarInvariant",
        "CrossFileAtomicityInvariant",
        "CleanupSafetyInvariant",
        "PackageInvariant",
        "PublicationRecoveryInvariant",
        "NoPartialGenerationInvariant",
        "StorageEventuallySettles"
      ],
      "coverage": "bounded",
      "notModeled": [
        "SQLite pager/journal/WAL/locking algorithms",
        "filesystem durability guarantees",
        "implementation-specific backup formats"
      ]
    },
    "include-hygiene-and-transformations": {
      "modules": ["CidxBehavior", "CidxSemanticGraph"],
      "invariants": ["IncludeHygieneInvariant", "TransformPublicationInvariant", "TransformConsumptionInvariant", "RecoveryTraceInvariant", "RecoveryFailureHonestyInvariant", "FailureHonestyInvariant", "QueryHonestyInvariant"]
    }
  },
  "protectedPaths": [
    "protected/",
    "trusted/",
    "modules/CidxTypes.tla",
    "models/*.cfg"
  ],
  "conformance": {
    "operations": "conformance/operation-map.json",
    "observations": "conformance/observation-map.json",
    "scenarios": "conformance/scenarios.json"
  }
}
