# Build trees live under cidx-cpp/build*/ (design §3 — git-ignored).
build*/

# clangd index cache (machine-local).
.cache/

# clangd compile DB symlink -> build/compile_commands.json (machine-local; build/ is ignored).
/compile_commands.json

# Local LLVM checkout used for large-scale index testing.
test-repo/

# Python bytecode — never committed, wherever the interpreter drops it.
**/__pycache__/
*.py[cod]
*$py.class

# Python package environments, tool caches, and build artifacts.
**/.venv/
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
python/dist/
python/build/
python/*.egg-info/

# Generated per-checkout from compile_commands.json.in (absolute paths
# cannot be committed portably). See tests/CMakeLists.txt.
manifests/compile_commands.json

# Local editor/agent state — never part of the repository.
.obsidian/
.codex/
*.canvas
Untitled*.md
*.sw[a-p]
*~
.DS_Store

# UI prototype dependencies and build output.
ui/node_modules/
ui/dist/
web/node_modules/

# Generated by cidx itself when a command publishes an artifact into the
# workspace-local artifact store. Never a source input.
.cidx-artifacts/
