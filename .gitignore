# Build trees live under cidx-cpp/build*/ (design §3 — git-ignored).
build*/

# clangd index cache (machine-local).
.cache/

# clangd compile DB symlink -> build/compile_commands.json (machine-local; build/ is ignored).
/compile_commands.json

# Local LLVM checkout used for large-scale index testing.
test-repo/

# Python package environments, caches, and build artifacts.
python/.venv/
python/.pytest_cache/
python/.ruff_cache/
**/__pycache__/
python/dist/
python/build/
python/*.egg-info/

# Generated per-checkout from compile_commands.json.in (absolute paths
# cannot be committed portably). See tests/CMakeLists.txt.
manifests/compile_commands.json
