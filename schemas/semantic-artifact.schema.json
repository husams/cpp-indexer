{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CIDX artifact manifest",
  "type": "object",
  "required": [
    "artifact_kind",
    "schema_version",
    "catalog_version",
    "catalog_hash",
    "status",
    "trust",
    "evidence"
  ],
  "properties": {
    "artifact_kind": {
      "enum": [
        "semantic-index",
        "astgraph",
        "analysis-result",
        "query-result"
      ]
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "catalog_version": {
      "const": 1
    },
    "catalog_hash": {
      "const": "090236d604144c4b4624e67d9531e5b478eac215565939074922763ad4b4109c"
    },
    "status": {
      "enum": [
        "complete",
        "partial",
        "unknown",
        "error"
      ]
    },
    "evidence": {
      "enum": [
        "source",
        "derived",
        "inferred",
        "runtime",
        "assumption",
        "proof"
      ]
    },
    "trust": {
      "enum": [
        "unverified",
        "producer-verified",
        "reader-verified"
      ]
    }
  }
}
