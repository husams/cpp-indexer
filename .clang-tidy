---
# modernize-* includes macro-to-enum, and readability-* includes the enum
# initialization checks. Keep those enabled so named value sets are modeled as
# enums instead of preprocessor constants and enum storage stays deliberate.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  performance-*,
  modernize-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -bugprone-easily-swappable-parameters
WarningsAsErrors: ''
HeaderFilterRegex: '.*/src/.*'
FormatStyle: file
...
