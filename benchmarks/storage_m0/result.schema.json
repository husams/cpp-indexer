{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cpp-indexer.invalid/benchmarks/storage-m0/result-v1.schema.json",
  "title": "cpp-indexer Storage M0 benchmark result",
  "type": "object",
  "required": ["result_version", "benchmark", "schema_version", "manifest_sha256", "run_id", "storage", "operations", "queries", "counters", "gates"],
  "properties": {
    "result_version": {"const": "storage-m0/result-v1"},
    "benchmark": {"const": "storage-m0/v1"},
    "schema_version": {"const": 34},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "workload": {"type": "string"},
    "profile_id": {"type": "string"},
    "run_id": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "revision": {"type": ["string", "null"]},
    "environment": {"type": "object", "additionalProperties": true},
    "storage": {
      "type": "object",
      "required": ["database_bytes", "page_size", "page_count", "freelist_pages", "objects"],
      "properties": {
        "database_bytes": {"type": "integer", "minimum": 0},
        "page_size": {"type": "integer", "minimum": 1},
        "page_count": {"type": "integer", "minimum": 0},
        "freelist_pages": {"type": "integer", "minimum": 0},
        "freelist_bytes": {"type": "integer", "minimum": 0},
        "wal_bytes": {"type": "integer", "minimum": 0},
        "journal_bytes": {"type": "integer", "minimum": 0},
        "temp_bytes": {"type": ["integer", "null"], "minimum": 0},
        "inspection": {"enum": ["dbstat", "page_count"]},
        "objects": {"type": "array", "items": {"$ref": "#/$defs/storageObject"}}
      }
    },
    "operations": {"type": "object", "additionalProperties": true},
    "queries": {"type": "array", "items": {"$ref": "#/$defs/query"}},
    "counters": {"type": "object", "additionalProperties": true},
    "gates": {"type": "object", "additionalProperties": true},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "storageObject": {
      "type": "object",
      "required": ["name", "type", "row_count", "bytes"],
      "properties": {
        "name": {"type": "string"},
        "type": {"enum": ["table", "index"]},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "query": {
      "type": "object",
      "required": ["id", "sql", "parameters", "row_count", "truncated", "latency_ms", "plan", "status"],
      "properties": {
        "id": {"type": "string"},
        "category": {"type": "string"},
        "sql": {"type": "string"},
        "parameters": {"type": "array"},
        "row_count": {"type": ["integer", "null"], "minimum": 0},
        "truncated": {"type": "boolean"},
        "latency_ms": {"type": "object", "required": ["count", "p50_ms", "p95_ms", "p99_ms"], "additionalProperties": true},
        "plan": {"type": "array"},
        "status": {"enum": ["ok", "error"]}
      }
    }
  }
}
