# Complexity gate for the AST indexing engine (refactoring.md §Complexity
# limits). The limits are on LOGICAL lines, so the statement threshold (not a
# raw line count, which would punish comments) enforces the <=40 rule;
# NestingThreshold 4 corresponds to the "three nested blocks inside a
# function body" rule. Scoped to src/ast only.
Checks: '-*,readability-function-size,readability-function-cognitive-complexity'
CheckOptions:
  readability-function-size.StatementThreshold: '40'
  readability-function-size.NestingThreshold: '4'
  readability-function-cognitive-complexity.Threshold: '25'
