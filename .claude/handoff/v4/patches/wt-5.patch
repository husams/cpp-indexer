+    // S2-SC-08 — concurrent get-or-insert of same USR → exactly one id, no dup rows
+    #[test]
+    fn concurrent_same_usr_exactly_one_id() {
+        let (_dir, path) = make_tmp();
+        let alloc = SymbolAllocator::open(&path, 0).unwrap();
+        let ids: Vec<i64> = std::thread::scope(|s| {
+            let mut handles = Vec::new();
+            for _ in 0..8 {
+                let alloc_ref = &alloc;
+                handles
+                    .push(s.spawn(move || alloc_ref.get_or_insert_symbol("c:@C@Widget").unwrap()));
+            }
+            handles.into_iter().map(|h| h.join().unwrap()).collect()
+        });
+        let first = ids[0];
+        assert!(
+            ids.iter().all(|&id| id == first),
+            "all threads must get the same id"
+        );
+        // No duplicate rows.
+        let conn = Connection::open(&path).unwrap();
+        let count: i64 = conn
+            .query_row(
+                "SELECT COUNT(*) FROM symbols WHERE usr='c:@C@Widget'",
+                [],
+                |r| r.get(0),
+            )
+            .unwrap();
+        assert_eq!(count, 1);
+    }
+
+    // S2-SC-09 — concurrent distinct USRs → distinct ids
+    #[test]
+    fn concurrent_distinct_usrs() {
+        let (_dir, path) = make_tmp();
+        let alloc = SymbolAllocator::open(&path, 0).unwrap();
+        let usrs = [
+            "c:@C@Foo", "c:@C@Bar", "c:@C@Baz", "c:@C@Qux", "c:@C@A", "c:@C@B", "c:@C@C", "c:@C@D",
+        ];
+        let ids: Vec<i64> = std::thread::scope(|s| {
+            let mut handles = Vec::new();
+            for &usr in &usrs {
+                let alloc_ref = &alloc;
+                handles.push(s.spawn(move || alloc_ref.get_or_insert_symbol(usr).unwrap()));
+            }
+            handles.into_iter().map(|h| h.join().unwrap()).collect()
+        });
+        let mut sorted = ids.clone();
+        sorted.sort_unstable();
+        sorted.dedup();
+        assert_eq!(
+            sorted.len(),
+            usrs.len(),
+            "all distinct USRs must get distinct ids"
+        );
+    }
+
+    // S2-SC-10 — N≥8 threads allocate concurrently, no deadlock/panic
+    #[test]
+    fn concurrent_no_deadlock() {
+        let (_dir, path) = make_tmp();
+        let alloc = SymbolAllocator::open(&path, 100).unwrap();
+        std::thread::scope(|s| {
+            let mut handles = Vec::new();
+            for i in 0..16_u32 {
+                let alloc_ref = &alloc;
+                handles.push(s.spawn(move || {
+                    for j in 0..10_u32 {
+                        let usr = format!("c:@C@T{i}_{j}");
+                        let file = format!("/src/{i}_{j}.cpp");
+                        alloc_ref.get_or_insert_symbol(&usr).unwrap();
+                        alloc_ref.get_or_insert_file(&file).unwrap();
+                    }
+                }));
+            }
+            for h in handles {
+                h.join().unwrap();
+            }
+        });
+    }
