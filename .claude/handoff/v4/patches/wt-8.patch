+// ── Public write handle ───────────────────────────────────────────────────────
+
+/// Thread-safe per-repo symbol/file allocator backed by SQLite + write-through LRU.
+///
+/// Construct via [`SymbolAllocator::open`]; share across threads with `Arc<SymbolAllocator>`.
+pub struct SymbolAllocator {
+    inner: Mutex<Inner>,
+    db_path: PathBuf,
+}
+
+impl SymbolAllocator {
+    /// Open (or create) the SQLite database at `path` with LRU `cache_size`.
+    /// `cache_size == 0` disables the cache.
+    pub fn open(path: impl AsRef<Path>, cache_size: usize) -> Result<Self, Error> {
+        let path = path.as_ref().to_path_buf();
+        let inner = Inner::open(&path, cache_size, false)?;
+        Ok(Self {
+            inner: Mutex::new(inner),
+            db_path: path,
+        })
+    }
+
+    /// Return the path to the underlying SQLite database.
+    pub fn db_path(&self) -> &Path {
+        &self.db_path
+    }
+
+    /// Get-or-insert a USR string; returns the stable integer ID.
+    pub fn get_or_insert_symbol(&self, usr: &str) -> Result<i64, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("symbol allocator mutex poisoned".into()))?
+            .get_or_insert_symbol(usr)
+    }
+
+    /// Get-or-insert a file path string; returns the stable integer ID.
+    pub fn get_or_insert_file(&self, path: &str) -> Result<i64, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("symbol allocator mutex poisoned".into()))?
+            .get_or_insert_file(path)
+    }
+
+    /// Resolve an integer symbol ID back to the USR string.
+    /// Returns `Ok(None)` for unknown IDs.
+    pub fn resolve_symbol(&self, id: i64) -> Result<Option<String>, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("symbol allocator mutex poisoned".into()))?
+            .resolve_symbol(id)
+    }
+
+    /// Resolve an integer file ID back to the path string.
+    /// Returns `Ok(None)` for unknown IDs.
+    pub fn resolve_file(&self, id: i64) -> Result<Option<String>, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("symbol allocator mutex poisoned".into()))?
+            .resolve_file(id)
+    }
+
+    /// Open a read-only resolver handle against the same DB (e.g. for cross-repo lookups).
+    pub fn open_readonly(
+        path: impl AsRef<Path>,
+        cache_size: usize,
+    ) -> Result<ReadOnlyResolver, Error> {
+        ReadOnlyResolver::open(path, cache_size)
+    }
+}
+
+// ── Public read-only handle ───────────────────────────────────────────────────
+
+/// Read-only resolver: opens an arbitrary repo's `cxg-symbols.db` for reverse lookups.
+///
+/// Used by Phase 5 cross-repo resolution and the daemon read path.
+pub struct ReadOnlyResolver {
+    inner: Mutex<Inner>,
+    db_path: PathBuf,
+}
+
+impl ReadOnlyResolver {
+    /// Open an existing SQLite DB at `path` in read-only mode.
+    pub fn open(path: impl AsRef<Path>, cache_size: usize) -> Result<Self, Error> {
+        let path = path.as_ref().to_path_buf();
+        let inner = Inner::open(&path, cache_size, true)?;
+        Ok(Self {
+            inner: Mutex::new(inner),
+            db_path: path,
+        })
+    }
+
+    /// Return the path to the underlying SQLite database.
+    pub fn db_path(&self) -> &Path {
+        &self.db_path
+    }
+
+    /// Resolve a symbol ID → USR.  Returns `Ok(None)` if not found.
+    pub fn resolve_symbol(&self, id: i64) -> Result<Option<String>, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("readonly resolver mutex poisoned".into()))?
+            .resolve_symbol(id)
+    }
+
+    /// Resolve a file ID → path string.  Returns `Ok(None)` if not found.
+    pub fn resolve_file(&self, id: i64) -> Result<Option<String>, Error> {
+        self.inner
+            .lock()
+            .map_err(|_| Error::Cache("readonly resolver mutex poisoned".into()))?
+            .resolve_file(id)
+    }
+}
