+// ── Tests ──────────────────────────────────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use tempfile::NamedTempFile;
+
+    fn temp_alloc(cache_size: usize) -> (SymbolAllocator, NamedTempFile) {
+        let f = NamedTempFile::new().unwrap();
+        let a = SymbolAllocator::open(f.path(), cache_size).unwrap();
+        (a, f)
+    }
+
+    // S7-SC-01: insert new USR → new id + row
+    #[test]
+    fn insert_new_usr_allocates_id() {
+        let (a, _f) = temp_alloc(16);
+        let id = a.get_or_insert_symbol("c:@F@foo").unwrap();
+        assert!(id > 0);
+    }
+
+    // S7-SC-02: dup USR → same id, no new row
+    #[test]
+    fn dup_usr_returns_same_id() {
+        let (a, _f) = temp_alloc(16);
+        let id1 = a.get_or_insert_symbol("c:@F@dup").unwrap();
+        let id2 = a.get_or_insert_symbol("c:@F@dup").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-03: insert new path → new id
+    #[test]
+    fn insert_new_path_allocates_id() {
+        let (a, _f) = temp_alloc(16);
+        let id = a.get_or_insert_file("/foo/bar.cpp").unwrap();
+        assert!(id > 0);
+    }
+
+    // S7-SC-04: dup path → same id
+    #[test]
+    fn dup_path_returns_same_id() {
+        let (a, _f) = temp_alloc(16);
+        let id1 = a.get_or_insert_file("/foo/bar.cpp").unwrap();
+        let id2 = a.get_or_insert_file("/foo/bar.cpp").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-05: persistence across reopen
+    #[test]
+    fn persistence_across_reopen() {
+        let f = NamedTempFile::new().unwrap();
+        let id1 = {
+            let a = SymbolAllocator::open(f.path(), 16).unwrap();
+            a.get_or_insert_symbol("c:@F@persist").unwrap()
+        };
+        let id2 = {
+            let a = SymbolAllocator::open(f.path(), 16).unwrap();
+            a.get_or_insert_symbol("c:@F@persist").unwrap()
+        };
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-06: cache hit returns correct id
+    #[test]
+    fn cache_hit_returns_id() {
+        let (a, _f) = temp_alloc(16);
+        let id1 = a.get_or_insert_symbol("c:@F@cached").unwrap();
+        let id2 = a.get_or_insert_symbol("c:@F@cached").unwrap(); // should be cache hit
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-07: cache miss queries SQLite
+    #[test]
+    fn cache_miss_queries_sqlite_and_populates() {
+        let f = NamedTempFile::new().unwrap();
+        // Insert with one allocator (populates SQLite)
+        let id_orig = {
+            let a = SymbolAllocator::open(f.path(), 0).unwrap(); // cache disabled
+            a.get_or_insert_symbol("c:@F@baz").unwrap()
+        };
+        // Open a new allocator (empty cache) — must hit SQLite
+        let a2 = SymbolAllocator::open(f.path(), 16).unwrap();
+        let id_new = a2.get_or_insert_symbol("c:@F@baz").unwrap();
+        assert_eq!(id_orig, id_new);
+    }
+
+    // S7-SC-08: LRU eviction
+    #[test]
+    fn lru_eviction_removes_lru_entry() {
+        let (a, _f) = temp_alloc(1); // cap=1
+        let id_x = a.get_or_insert_symbol("c:@F@x").unwrap();
+        // Second insert evicts "x"
+        let _id_y = a.get_or_insert_symbol("c:@F@y").unwrap();
+        // "x" is still resolvable via SQLite (write-through)
+        let resolved = a.resolve_symbol(id_x).unwrap();
+        assert_eq!(resolved.as_deref(), Some("c:@F@x"));
+    }
+
+    // S7-SC-09: cache_size=0 disables caching (every call goes to SQLite)
+    #[test]
+    fn cache_size_zero_disables_cache() {
+        let (a, _f) = temp_alloc(0);
+        let id1 = a.get_or_insert_symbol("c:@F@nocache").unwrap();
+        let id2 = a.get_or_insert_symbol("c:@F@nocache").unwrap();
+        assert_eq!(id1, id2); // correctness preserved even without cache
+    }
+
+    // S7-SC-10: both directions (usr→id and id→usr)
+    #[test]
+    fn both_direction_usr() {
+        let (a, _f) = temp_alloc(16);
+        let id = a.get_or_insert_symbol("c:@F@bidir").unwrap();
+        let resolved = a.resolve_symbol(id).unwrap();
+        assert_eq!(resolved.as_deref(), Some("c:@F@bidir"));
+    }
+
+    // S7-SC-11: both directions (path→id and id→path)
+    #[test]
+    fn both_direction_path() {
+        let (a, _f) = temp_alloc(16);
+        let id = a.get_or_insert_file("/src/main.cpp").unwrap();
+        let resolved = a.resolve_file(id).unwrap();
+        assert_eq!(resolved.as_deref(), Some("/src/main.cpp"));
+    }
+
+    // S2-SC-08: concurrent same-usr → exactly one id
+    #[test]
+    fn concurrent_same_usr_one_id() {
+        use std::sync::Arc;
+        let f = NamedTempFile::new().unwrap();
+        let a = Arc::new(SymbolAllocator::open(f.path(), 16).unwrap());
+        let n = 8;
+        let ids: Vec<i64> = std::thread::scope(|s| {
+            let handles: Vec<_> = (0..n)
+                .map(|_| {
+                    let a = Arc::clone(&a);
+                    s.spawn(move || a.get_or_insert_symbol("c:@C@Widget").unwrap())
+                })
+                .collect();
+            handles.into_iter().map(|h| h.join().unwrap()).collect()
+        });
+        let first = ids[0];
+        assert!(ids.iter().all(|&id| id == first));
+    }
+
+    // S2-SC-09: concurrent distinct usrs → distinct ids
+    #[test]
+    fn concurrent_distinct_usrs_distinct_ids() {
+        use std::sync::Arc;
+        let f = NamedTempFile::new().unwrap();
+        let a = Arc::new(SymbolAllocator::open(f.path(), 16).unwrap());
+        let usrs = ["c:@C@Foo", "c:@C@Bar", "c:@C@Baz", "c:@C@Qux"];
+        let ids: Vec<i64> = std::thread::scope(|s| {
+            let handles: Vec<_> = usrs
+                .iter()
+                .map(|&usr| {
+                    let a = Arc::clone(&a);
+                    s.spawn(move || a.get_or_insert_symbol(usr).unwrap())
+                })
+                .collect();
+            handles.into_iter().map(|h| h.join().unwrap()).collect()
+        });
+        let mut sorted = ids.clone();
+        sorted.sort_unstable();
+        sorted.dedup();
+        assert_eq!(sorted.len(), ids.len(), "all IDs must be distinct");
+    }
+
+    // S2-SC-10: N≥8 threads, no deadlock/panic
+    #[test]
+    fn parallel_no_deadlock() {
+        use std::sync::Arc;
+        let f = NamedTempFile::new().unwrap();
+        let a = Arc::new(SymbolAllocator::open(f.path(), 64).unwrap());
+        std::thread::scope(|s| {
+            let handles: Vec<_> = (0..16)
+                .map(|i| {
+                    let a = Arc::clone(&a);
+                    s.spawn(move || {
+                        let usr = format!("c:@F@fn{i}");
+                        a.get_or_insert_symbol(&usr).unwrap();
+                        let path = format!("/src/file{i}.cpp");
+                        a.get_or_insert_file(&path).unwrap();
+                    })
+                })
+                .collect();
+            for h in handles {
+                h.join().unwrap();
+            }
+        });
+    }
+
+    // ReadOnlyResolver: basic resolve
+    #[test]
+    fn readonly_resolver_resolves() {
+        let f = NamedTempFile::new().unwrap();
+        let id = {
+            let a = SymbolAllocator::open(f.path(), 0).unwrap();
+            a.get_or_insert_symbol("c:@F@readonly_test").unwrap()
+        };
+        let r = ReadOnlyResolver::open(f.path(), 0).unwrap();
+        let resolved = r.resolve_symbol(id).unwrap();
+        assert_eq!(resolved.as_deref(), Some("c:@F@readonly_test"));
+    }
+}
