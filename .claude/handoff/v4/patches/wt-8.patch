+++ b/src/api/routes.rs
@@ -517,4 +517,55 @@ mod tests {
         let resp = app.oneshot(req).await.unwrap();
         assert_eq!(resp.status(), StatusCode::OK);
     }
+
+    // S5-SC-02: GET /v1/repos returns only repo metadata — no raw integer IDs.
+    //
+    // RepoInfo has fields: name (String), path (String), last_job_id (String).
+    // None are integer symbol/file IDs, so the response contract is already
+    // string-only.  This test asserts that none of the well-known integer-id
+    // field names (symbol_id, file_id, src_id, dst_id) appear in the response.
+    #[tokio::test]
+    async fn get_repos_contains_no_raw_integer_ids() {
+        let (queue, _rx) = JobQueue::new(64);
+        let repos = RepoRegistry::new();
+        repos.upsert(super::super::jobs::RepoInfo {
+            name: "no-ids-repo".to_owned(),
+            path: "/workspace/no-ids-repo".to_owned(),
+            last_job_id: "job-42".to_owned(),
+        });
+        let sink = Arc::new(MockSink::default());
+        let listen: SocketAddr = "127.0.0.1:7878".parse().unwrap();
+        let state = AppState {
+            queue,
+            repos,
+            sink,
+            listen,
+            version: "0.1.0-test".to_owned(),
+            workspace_cfg: None,
+            stage_root: std::env::temp_dir(),
+        };
+        let app = build_router(state, BearerToken(TOKEN.to_owned()));
+
+        let req = Request::builder()
+            .method(http::Method::GET)
+            .uri("/v1/repos")
+            .body(Body::empty())
+            .unwrap();
+
+        let resp = app.oneshot(req).await.unwrap();
+        assert_eq!(resp.status(), StatusCode::OK);
+
+        let bytes = axum::body::to_bytes(resp.into_body(), 1024 * 64)
+            .await
+            .unwrap();
+        let body_str = std::str::from_utf8(&bytes).unwrap();
+
+        // None of the integer-id field names should appear in the response.
+        for forbidden in &["symbol_id", "file_id", "src_id", "dst_id"] {
+            assert!(
+                !body_str.contains(forbidden),
+                "GET /v1/repos must not expose raw integer id field `{forbidden}`"
+            );
+        }
+    }
 }
diff --git a/src/resolve/id_resolver.rs b/src/resolve/id_resolver.rs
new file mode 100644
index 0000000..271a58c
--- /dev/null
+++ b/src/resolve/id_resolver.rs
@@ -0,0 +1,283 @@
+//! Reverse-resolver: integer ID → USR/path, scoped per repo.
+//!
+//! # Design (Story 4, ADR-1 consequence)
+//! Integer IDs are per-repo (D1). `IdResolver` wraps one or more [`ReadOnlyResolver`]
+//! handles keyed by `repo_name`. For an EXTERNAL_REF edge, `src_id` is resolved via
+//! the source repo's map and `dst_id` via the destination repo's map.
+//!
+//! On missing/unknown ID or unavailable SQLite the resolver returns an explicit
+//! [`Error::Cache`] — never fabricated or blank data (C7, S5-SC-03).
+
+use std::{
+    collections::HashMap,
+    path::{Path, PathBuf},
+    sync::Mutex,
+};
+
+use crate::error::Error;
+
+use super::symbol_map::ReadOnlyResolver;
+
+// ── Repo-scoped resolver entry ────────────────────────────────────────────────
+
+struct RepoEntry {
+    resolver: ReadOnlyResolver,
+}
+
+// ── IdResolver ────────────────────────────────────────────────────────────────
+
+/// Multi-repo read-path resolver.
+///
+/// Call [`IdResolver::add_repo`] for each known repo, then use
+/// [`IdResolver::resolve_node`] / [`IdResolver::resolve_edge_src`] /
+/// [`IdResolver::resolve_edge_dst`] to recover strings.
+pub struct IdResolver {
+    repos: Mutex<HashMap<String, RepoEntry>>,
+    cache_size: usize,
+}
+
+impl IdResolver {
+    /// Create a resolver; `cache_size` is passed to every [`ReadOnlyResolver`] opened.
+    pub fn new(cache_size: usize) -> Self {
+        Self {
+            repos: Mutex::new(HashMap::new()),
+            cache_size,
+        }
+    }
+
+    /// Register a repo by name, pointing at its `cxg-symbols.db`.
+    ///
+    /// If the repo is already registered the call is a no-op.
+    pub fn add_repo(
+        &self,
+        repo_name: impl Into<String>,
+        db_path: impl AsRef<Path>,
+    ) -> Result<(), Error> {
+        let name = repo_name.into();
+        let mut repos = self
+            .repos
+            .lock()
+            .map_err(|_| Error::Cache("id_resolver mutex poisoned".into()))?;
+        if repos.contains_key(&name) {
+            return Ok(());
+        }
+        let resolver = ReadOnlyResolver::open(db_path.as_ref(), self.cache_size)?;
+        repos.insert(name, RepoEntry { resolver });
+        Ok(())
+    }
+
+    // ── Core resolution helpers ───────────────────────────────────────────────
+
+    /// Resolve `symbol_id` and `file_id` from a given repo.
+    ///
+    /// Returns `(usr, file_path)`.
+    /// Errors if the repo is unknown, the DB is unavailable, or either ID has no row.
+    pub fn resolve_node(
+        &self,
+        repo_name: &str,
+        symbol_id: i64,
+        file_id: i64,
+    ) -> Result<(String, String), Error> {
+        let repos = self
+            .repos
+            .lock()
+            .map_err(|_| Error::Cache("id_resolver mutex poisoned".into()))?;
+        let entry = repos.get(repo_name).ok_or_else(|| {
+            Error::Cache(format!(
+                "id_resolver: unknown repo `{repo_name}`; register it with add_repo first"
+            ))
+        })?;
+
+        let usr = entry.resolver.resolve_symbol(symbol_id)?.ok_or_else(|| {
+            Error::Cache(format!(
+                "id_resolver: symbol_id {symbol_id} not found in repo `{repo_name}`"
+            ))
+        })?;
+
+        let file_path = entry.resolver.resolve_file(file_id)?.ok_or_else(|| {
+            Error::Cache(format!(
+                "id_resolver: file_id {file_id} not found in repo `{repo_name}`"
+            ))
+        })?;
+
+        Ok((usr, file_path))
+    }
+
+    /// Resolve the **source** endpoint of an edge: `src_id` in `repo_name`.
+    pub fn resolve_edge_src(&self, repo_name: &str, src_id: i64) -> Result<String, Error> {
+        let repos = self
+            .repos
+            .lock()
+            .map_err(|_| Error::Cache("id_resolver mutex poisoned".into()))?;
+        let entry = repos
+            .get(repo_name)
+            .ok_or_else(|| Error::Cache(format!("id_resolver: unknown repo `{repo_name}`")))?;
+        entry.resolver.resolve_symbol(src_id)?.ok_or_else(|| {
+            Error::Cache(format!(
+                "id_resolver: src_id {src_id} not found in repo `{repo_name}`"
+            ))
+        })
+    }
+
+    /// Resolve the **destination** endpoint of an EXTERNAL_REF edge:
+    /// `dst_id` in `dst_repo_name` (different repo from source).
+    pub fn resolve_edge_dst(&self, dst_repo_name: &str, dst_id: i64) -> Result<String, Error> {
+        let repos = self
+            .repos
+            .lock()
+            .map_err(|_| Error::Cache("id_resolver mutex poisoned".into()))?;
+        let entry = repos
+            .get(dst_repo_name)
+            .ok_or_else(|| Error::Cache(format!("id_resolver: unknown repo `{dst_repo_name}`")))?;
+        entry.resolver.resolve_symbol(dst_id)?.ok_or_else(|| {
+            Error::Cache(format!(
+                "id_resolver: dst_id {dst_id} not found in repo `{dst_repo_name}`"
+            ))
+        })
+    }
+
+    /// List the repo names currently registered.
+    pub fn repo_names(&self) -> Vec<String> {
+        self.repos
+            .lock()
+            .map(|r| r.keys().cloned().collect())
+            .unwrap_or_default()
+    }
+}
+
+// ── Builder helper ────────────────────────────────────────────────────────────
+
+/// Convenience: build an [`IdResolver`] from a `repo_name → db_path` map.
+pub fn build_resolver(
+    repos: impl IntoIterator<Item = (String, PathBuf)>,
+    cache_size: usize,
+) -> Result<IdResolver, Error> {
+    let resolver = IdResolver::new(cache_size);
+    for (name, path) in repos {
+        resolver.add_repo(name, path)?;
+    }
+    Ok(resolver)
+}
+
+// ── Tests ──────────────────────────────────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::resolve::symbol_map::SymbolAllocator;
+    use tempfile::NamedTempFile;
+
+    // S5-SC-01: resolver maps ids → usr/path
+    #[test]
+    fn resolve_node_roundtrip() {
+        let f = NamedTempFile::new().unwrap();
+        let a = SymbolAllocator::open(f.path(), 0).unwrap();
+        let sym_id = a.get_or_insert_symbol("c:@F@resolve_me").unwrap();
+        let file_id = a.get_or_insert_file("/src/resolve.cpp").unwrap();
+
+        let r = IdResolver::new(0);
+        r.add_repo("my_repo", f.path()).unwrap();
+
+        let (usr, path) = r.resolve_node("my_repo", sym_id, file_id).unwrap();
+        assert_eq!(usr, "c:@F@resolve_me");
+        assert_eq!(path, "/src/resolve.cpp");
+    }
+
+    // S5-SC-03: missing id → explicit error
+    #[test]
+    fn missing_id_returns_error() {
+        let f = NamedTempFile::new().unwrap();
+        let _a = SymbolAllocator::open(f.path(), 0).unwrap(); // creates schema
+
+        let r = IdResolver::new(0);
+        r.add_repo("repo_a", f.path()).unwrap();
+
+        let err = r.resolve_node("repo_a", 9999, 9998);
+        assert!(err.is_err(), "unknown id must return error");
+        let msg = err.unwrap_err().to_string();
+        assert!(
+            msg.contains("9999"),
+            "error message must mention the missing id"
+        );
+    }
+
+    // S5-SC-03: unknown repo → explicit error
+    #[test]
+    fn unknown_repo_returns_error() {
+        let r = IdResolver::new(0);
+        let err = r.resolve_node("no_such_repo", 1, 1);
+        assert!(err.is_err());
+        assert!(err.unwrap_err().to_string().contains("no_such_repo"));
+    }
+
+    // S5-SC-04: round-trip preserves original strings
+    #[test]
+    fn roundtrip_preserves_strings() {
+        let f = NamedTempFile::new().unwrap();
+        let a = SymbolAllocator::open(f.path(), 16).unwrap();
+
+        let usrs = ["c:@C@Widget", "c:@F@render", "c:@V@global_count"];
+        let paths = ["/src/widget.cpp", "/src/render.cpp", "/src/globals.cpp"];
+
+        let ids: Vec<(i64, i64)> = usrs
+            .iter()
+            .zip(paths.iter())
+            .map(|(&u, &p)| {
+                (
+                    a.get_or_insert_symbol(u).unwrap(),
+                    a.get_or_insert_file(p).unwrap(),
+                )
+            })
+            .collect();
+
+        let r = IdResolver::new(16);
+        r.add_repo("repo", f.path()).unwrap();
+
+        for (i, (&usr, &path)) in usrs.iter().zip(paths.iter()).enumerate() {
+            let (sym_id, file_id) = ids[i];
+            let (got_usr, got_path) = r.resolve_node("repo", sym_id, file_id).unwrap();
+            assert_eq!(got_usr, usr);
+            assert_eq!(got_path, path);
+        }
+    }
+
+    // Cross-repo: resolve src from repo_a, dst from repo_b
+    #[test]
+    fn cross_repo_resolve_edge() {
+        let fa = NamedTempFile::new().unwrap();
+        let fb = NamedTempFile::new().unwrap();
+
+        let a = SymbolAllocator::open(fa.path(), 0).unwrap();
+        let src_id = a.get_or_insert_symbol("c:@F@src_fn").unwrap();
+
+        let b = SymbolAllocator::open(fb.path(), 0).unwrap();
+        let dst_id = b.get_or_insert_symbol("c:@F@dst_fn").unwrap();
+
+        let r = IdResolver::new(0);
+        r.add_repo("repo_a", fa.path()).unwrap();
+        r.add_repo("repo_b", fb.path()).unwrap();
+
+        let src_usr = r.resolve_edge_src("repo_a", src_id).unwrap();
+        let dst_usr = r.resolve_edge_dst("repo_b", dst_id).unwrap();
+
+        assert_eq!(src_usr, "c:@F@src_fn");
+        assert_eq!(dst_usr, "c:@F@dst_fn");
+    }
+
+    // repo_names lists registered repos
+    #[test]
+    fn repo_names_lists_all() {
+        let fa = NamedTempFile::new().unwrap();
+        let fb = NamedTempFile::new().unwrap();
+        // Ensure both DBs are writable (schema init)
+        SymbolAllocator::open(fa.path(), 0).unwrap();
+        SymbolAllocator::open(fb.path(), 0).unwrap();
+
+        let r = IdResolver::new(0);
+        r.add_repo("alpha", fa.path()).unwrap();
+        r.add_repo("beta", fb.path()).unwrap();
+        let mut names = r.repo_names();
+        names.sort();
+        assert_eq!(names, ["alpha", "beta"]);
+    }
+}
