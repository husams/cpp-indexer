+// ── S7-SC-13: both-sink round-trip (mock sink / SQLite only) ──────────────────
+//
+// We write nodes and edges with integer IDs via SymbolAllocator (representing
+// what the Neo4j/IndraDB sink would persist), then resolve via IdResolver and
+// verify the original USR strings and file paths are recovered.
+#[test]
+fn symbol_id_round_trip_usr_and_path() {
+    let db = NamedTempFile::new().unwrap();
+    let alloc = SymbolAllocator::open(db.path(), 128).unwrap();
+
+    // Simulate a write: allocate IDs as the sink would.
+    let sym_id = alloc.get_or_insert_symbol("c:@C@Widget").unwrap();
+    let file_id = alloc.get_or_insert_file("/src/widget.cpp").unwrap();
+
+    // Simulate the read path: construct resolver, resolve IDs back to strings.
+    let resolver = IdResolver::new(128);
+    resolver.add_repo("widget_repo", db.path()).unwrap();
+
+    let (got_usr, got_path) = resolver
+        .resolve_node("widget_repo", sym_id, file_id)
+        .unwrap();
+
+    assert_eq!(got_usr, "c:@C@Widget", "S7-SC-13: USR round-trip");
+    assert_eq!(got_path, "/src/widget.cpp", "S7-SC-13: path round-trip");
+}
+
+// ── S7-SC-14: IndraDB-side round-trip (same SQLite store) ─────────────────────
+//
+// IndraDB sink uses the same SQLite allocator as Neo4j. We verify that a
+// different allocation order still produces correct resolution.
+#[test]
+fn symbol_id_round_trip_multiple_entries() {
+    let db = NamedTempFile::new().unwrap();
+    let alloc = SymbolAllocator::open(db.path(), 0).unwrap(); // cache disabled
+
+    let entries = [
+        ("c:@F@render", "/src/render.cpp"),
+        ("c:@F@update", "/src/update.cpp"),
+        ("c:@C@Engine", "/src/engine.cpp"),
+    ];
+
+    let ids: Vec<(i64, i64)> = entries
+        .iter()
+        .map(|&(usr, path)| {
+            (
+                alloc.get_or_insert_symbol(usr).unwrap(),
+                alloc.get_or_insert_file(path).unwrap(),
+            )
+        })
+        .collect();
+
+    let resolver = IdResolver::new(0);
+    resolver.add_repo("engine_repo", db.path()).unwrap();
+
+    for (i, &(usr, path)) in entries.iter().enumerate() {
+        let (sym_id, file_id) = ids[i];
+        let (got_usr, got_path) = resolver
+            .resolve_node("engine_repo", sym_id, file_id)
+            .unwrap();
+        assert_eq!(got_usr, usr, "S7-SC-14: USR mismatch at index {i}");
+        assert_eq!(got_path, path, "S7-SC-14: path mismatch at index {i}");
+    }
+}
