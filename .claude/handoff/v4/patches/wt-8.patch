diff --git a/src/resolve/symbol_map.rs b/src/resolve/symbol_map.rs
new file mode 100644
index 0000000..e05436e
--- /dev/null
+++ b/src/resolve/symbol_map.rs
@@ -0,0 +1,535 @@
+//! Per-repo SQLite symbol/file map with write-through LRU cache.
+//!
+//! # Usage
+//! - [`SymbolAllocator`]: write-capable handle (`get_or_insert_*`, `resolve_*`).
+//! - [`ReadOnlyResolver`]: lightweight read-only handle for cross-repo lookups.
+//!
+//! # Schema
+//! ```sql
+//! CREATE TABLE IF NOT EXISTS symbols (id INTEGER PRIMARY KEY, usr  TEXT NOT NULL UNIQUE);
+//! CREATE TABLE IF NOT EXISTS files   (id INTEGER PRIMARY KEY, path TEXT NOT NULL UNIQUE);
+//! PRAGMA journal_mode=WAL; PRAGMA synchronous=NORMAL;
+//! ```
+//!
+//! ADR-3: SQLite durable map + thread-safe allocator + write-through LRU.
+
+use std::{
+    num::NonZeroUsize,
+    path::{Path, PathBuf},
+    sync::Mutex,
+};
+
+use lru::LruCache;
+use rusqlite::{params, Connection, OptionalExtension as _};
+
+use crate::error::Error;
+
+// ── Bidirectional LRU cache ───────────────────────────────────────────────────
+
+/// Bidirectional write-through LRU cache: `String ↔ i64`.
+/// Invariant: both maps are kept in sync; every insert/evict touches both.
+struct BiCache {
+    fwd: LruCache<String, i64>, // string → id
+    rev: LruCache<i64, String>, // id    → string
+}
+
+impl BiCache {
+    fn new(cap: NonZeroUsize) -> Self {
+        Self {
+            fwd: LruCache::new(cap),
+            rev: LruCache::new(cap),
+        }
+    }
+
+    /// Insert both directions.  Evictions from `fwd` are mirrored on `rev`.
+    fn insert(&mut self, key: String, id: i64) {
+        // If we're about to evict an entry from `fwd`, remove the corresponding
+        // `rev` entry so the two maps stay consistent.
+        if self.fwd.len() == self.fwd.cap().get() {
+            if let Some((evicted_key, evicted_id)) = self.fwd.peek_lru() {
+                let eid = *evicted_id;
+                let _ = evicted_key; // borrow ends here
+                self.rev.pop(&eid);
+            }
+        }
+        // Same for the reverse map.
+        if self.rev.len() == self.rev.cap().get() {
+            if let Some((evicted_id, evicted_key)) = self.rev.peek_lru() {
+                let ekey = evicted_key.clone();
+                let _ = evicted_id;
+                self.fwd.pop(&ekey);
+            }
+        }
+        self.fwd.put(key.clone(), id);
+        self.rev.put(id, key);
+    }
+
+    fn get_by_key(&mut self, key: &str) -> Option<i64> {
+        self.fwd.get(key).copied()
+    }
+
+    fn get_by_id(&mut self, id: i64) -> Option<&str> {
+        self.rev.get(&id).map(String::as_str)
+    }
+}
+
+// ── Inner locked state ────────────────────────────────────────────────────────
+
+struct Inner {
+    conn: Connection,
+    sym_cache: Option<BiCache>,
+    file_cache: Option<BiCache>,
+}
+
+impl Inner {
+    fn open(path: &Path, cache_size: usize, read_only: bool) -> Result<Self, Error> {
+        let conn = if read_only {
+            Connection::open_with_flags(
+                path,
+                rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY
+                    | rusqlite::OpenFlags::SQLITE_OPEN_URI
+                    | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX,
+            )
+        } else {
+            Connection::open(path)
+        }
+        .map_err(|e| Error::Cache(format!("open {}: {e}", path.display())))?;
+
+        if !read_only {
+            conn.execute_batch(
+                "PRAGMA journal_mode=WAL;
+                 PRAGMA synchronous=NORMAL;
+                 CREATE TABLE IF NOT EXISTS symbols (
+                     id  INTEGER PRIMARY KEY,
+                     usr TEXT    NOT NULL UNIQUE
+                 );
+                 CREATE TABLE IF NOT EXISTS files (
+                     id   INTEGER PRIMARY KEY,
+                     path TEXT    NOT NULL UNIQUE
+                 );",
+            )
+            .map_err(|e| Error::Cache(format!("init schema: {e}")))?;
+        }
+
+        let cache = NonZeroUsize::new(cache_size);
+        let (sym_cache, file_cache) = match cache {
+            None => (None, None),
+            Some(cap) => (Some(BiCache::new(cap)), Some(BiCache::new(cap))),
+        };
+
+        Ok(Self {
+            conn,
+            sym_cache,
+            file_cache,
+        })
+    }
+
+    // ── Write path ───────────────────────────────────────────────────────────
+
+    fn get_or_insert_symbol(&mut self, usr: &str) -> Result<i64, Error> {
+        if let Some(ref mut c) = self.sym_cache {
+            if let Some(id) = c.get_by_key(usr) {
+                return Ok(id);
+            }
+        }
+        self.conn
+            .execute(
+                "INSERT INTO symbols (usr) VALUES (?1) ON CONFLICT(usr) DO NOTHING",
+                params![usr],
+            )
+            .map_err(|e| Error::Cache(format!("insert symbol: {e}")))?;
+        let id: i64 = self
+            .conn
+            .query_row("SELECT id FROM symbols WHERE usr = ?1", params![usr], |r| {
+                r.get(0)
+            })
+            .map_err(|e| Error::Cache(format!("select symbol: {e}")))?;
+        if let Some(ref mut c) = self.sym_cache {
+            c.insert(usr.to_owned(), id);
+        }
+        Ok(id)
+    }
+
+    fn get_or_insert_file(&mut self, path: &str) -> Result<i64, Error> {
+        if let Some(ref mut c) = self.file_cache {
+            if let Some(id) = c.get_by_key(path) {
+                return Ok(id);
+            }
+        }
+        self.conn
+            .execute(
+                "INSERT INTO files (path) VALUES (?1) ON CONFLICT(path) DO NOTHING",
+                params![path],
+            )
+            .map_err(|e| Error::Cache(format!("insert file: {e}")))?;
+        let id: i64 = self
+            .conn
+            .query_row("SELECT id FROM files WHERE path = ?1", params![path], |r| {
+                r.get(0)
+            })
+            .map_err(|e| Error::Cache(format!("select file: {e}")))?;
+        if let Some(ref mut c) = self.file_cache {
+            c.insert(path.to_owned(), id);
+        }
+        Ok(id)
+    }
+
+    // ── Reverse resolve ──────────────────────────────────────────────────────
+
+    fn resolve_symbol(&mut self, id: i64) -> Result<Option<String>, Error> {
+        if let Some(ref mut c) = self.sym_cache {
+            if let Some(s) = c.get_by_id(id) {
+                return Ok(Some(s.to_owned()));
+            }
+        }
+        let usr: Option<String> = self
+            .conn
+            .query_row("SELECT usr FROM symbols WHERE id = ?1", params![id], |r| {
+                r.get(0)
+            })
+            .optional()
+            .map_err(|e| Error::Cache(format!("resolve symbol: {e}")))?;
+        if let (Some(ref mut c), Some(ref u)) = (&mut self.sym_cache, &usr) {
+            c.insert(u.clone(), id);
+        }
+        Ok(usr)
+    }
+
+    fn resolve_file(&mut self, id: i64) -> Result<Option<String>, Error> {
+        if let Some(ref mut c) = self.file_cache {
+            if let Some(s) = c.get_by_id(id) {
+                return Ok(Some(s.to_owned()));
+            }
+        }
+        let path: Option<String> = self
+            .conn
+            .query_row("SELECT path FROM files WHERE id = ?1", params![id], |r| {
+                r.get(0)
+            })
+            .optional()
+            .map_err(|e| Error::Cache(format!("resolve file: {e}")))?;
+        if let (Some(ref mut c), Some(ref p)) = (&mut self.file_cache, &path) {
+            c.insert(p.clone(), id);
+        }
+        Ok(path)
+    }
+}
