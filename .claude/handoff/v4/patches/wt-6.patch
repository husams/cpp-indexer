+/// Resolve `symbol_cache_size` from environment + config, applying the
+/// CLI > env > file > default precedence chain.
+///
+/// `cli_value` is `Some(n)` when `--symbol-cache-size <N>` is supplied on the
+/// CLI.  `file_value` is the value parsed from a config file (if any).  The
+/// env var consulted is `CXG_SYMBOL_CACHE_SIZE`.
+///
+/// # Errors
+///
+/// Returns [`Error::Config`] if `CXG_SYMBOL_CACHE_SIZE` is set to a value that
+/// cannot be parsed as a `usize`.
+pub fn resolve_symbol_cache_size(
+    cli_value: Option<usize>,
+    file_value: Option<usize>,
+) -> crate::error::Result<usize> {
+    resolve_symbol_cache_size_with_env(cli_value, file_value, "CXG_SYMBOL_CACHE_SIZE")
+}
+
+/// Inner implementation; `env_var` is the environment variable name to
+/// consult.  Extracted so tests can pass unique names and avoid process-global
+/// env races in the parallel test runner.
+pub(crate) fn resolve_symbol_cache_size_with_env(
+    cli_value: Option<usize>,
+    file_value: Option<usize>,
+    env_var: &str,
+) -> crate::error::Result<usize> {
+    // CLI wins unconditionally.
+    if let Some(v) = cli_value {
+        return Ok(v);
+    }
+    // Env var overrides file value.
+    if let Ok(raw) = env::var(env_var) {
+        let parsed = raw
+            .parse::<usize>()
+            .map_err(|_| crate::error::Error::Config {
+                field: env_var.to_owned(),
+                detail: format!("env var `{env_var}` value `{raw}` is not a valid usize"),
+            })?;
+        return Ok(parsed);
+    }
+    // File value, then default.
+    Ok(file_value.unwrap_or(super::DEFAULT_SYMBOL_CACHE_SIZE))
+}
+
+/// Resolve `symbol_db_path` from environment + config, applying the
+/// CLI > env > file > default precedence chain.
+///
+/// Returns `None` when no value is configured; the use site then resolves
+/// the path to `<stage_dir>/cxg-symbols.db`.  The env var consulted is
+/// `CXG_SYMBOL_DB_PATH`.
+pub fn resolve_symbol_db_path(
+    cli_value: Option<std::path::PathBuf>,
+    file_value: Option<std::path::PathBuf>,
+) -> Option<std::path::PathBuf> {
+    resolve_symbol_db_path_with_env(cli_value, file_value, "CXG_SYMBOL_DB_PATH")
+}
+
+/// Inner implementation; `env_var` is the environment variable name to
+/// consult.  Extracted so tests can pass unique names.
+pub(crate) fn resolve_symbol_db_path_with_env(
+    cli_value: Option<std::path::PathBuf>,
+    file_value: Option<std::path::PathBuf>,
+    env_var: &str,
+) -> Option<std::path::PathBuf> {
+    // CLI wins unconditionally.
+    if let Some(v) = cli_value {
+        return Some(v);
+    }
+    // Env var overrides file value.
+    if let Ok(raw) = env::var(env_var) {
+        return Some(std::path::PathBuf::from(raw));
+    }
+    // File value, then default (None).
+    file_value
+}
