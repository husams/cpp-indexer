+/// S7-SC-12: Persistent re-index stability via tempfile SQLite.
+#[test]
+fn reindex_stability_with_persistent_db() {
+    let dir = tempfile::tempdir().unwrap();
+    let db_path = dir.path().join("test.db");
+
+    // First index run.
+    let ids_run1: Vec<i64> = {
+        let alloc = SymbolAllocator::open(&db_path, 0).unwrap();
+        ["c:@F@alpha", "c:@F@beta", "c:@F@gamma"]
+            .iter()
+            .map(|&u| alloc.get_or_insert_symbol(u).unwrap())
+            .collect()
+    };
+
+    // Second index run (re-open same db).
+    let ids_run2: Vec<i64> = {
+        let alloc = SymbolAllocator::open(&db_path, 0).unwrap();
+        ["c:@F@alpha", "c:@F@beta", "c:@F@gamma"]
+            .iter()
+            .map(|&u| alloc.get_or_insert_symbol(u).unwrap())
+            .collect()
+    };
+
+    assert_eq!(
+        ids_run1, ids_run2,
+        "persistent re-index: same USRs must produce same IDs across process reopens"
+    );
+}
