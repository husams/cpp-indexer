+/// Resolve a USR to its integer symbol_id using the cached read-only SymbolAllocator for `repo`.
+///
+/// Returns `Some(id)` on success, `None` on SQLite unavailability or missing row.
+/// This is used by Phase 5 to resolve src_id (source repo) and dst_id (destination repo)
+/// for EXTERNAL_REF edge emission (ADR-1 points 4-5).
+fn resolve_id_from_repo(
+    repo_name: &str,
+    usr: &str,
+    repo_stage_map: &HashMap<String, PathBuf>,
+    alloc_cache: &mut HashMap<String, SymbolAllocator>,
+) -> Option<i64> {
+    if !alloc_cache.contains_key(repo_name) {
+        let stage_dir = repo_stage_map.get(repo_name)?;
+        let db_path = SymbolAllocator::default_db_path(stage_dir);
+        if !db_path.exists() {
+            warn!(
+                "phase5: no cxg-symbols.db for repo '{}' at {:?}",
+                repo_name, db_path
+            );
+            return None;
+        }
+        match SymbolAllocator::open_readonly(&db_path, 0) {
+            Ok(a) => {
+                alloc_cache.insert(repo_name.to_owned(), a);
+            }
+            Err(e) => {
+                warn!(
+                    "phase5: cannot open cxg-symbols.db for repo '{}': {}",
+                    repo_name, e
+                );
+                return None;
+            }
+        }
+    }
+    let alloc = alloc_cache.get(repo_name)?;
+    match alloc.get_or_insert_symbol(usr) {
+        Ok(id) => Some(id),
+        Err(e) => {
+            warn!(
+                "phase5: symbol resolve failed for '{}' in repo '{}': {}",
+                usr, repo_name, e
+            );
+            None
+        }
+    }
+}
+
+/// Build a map from repo_name → stage_dir by scanning REPO-kind nodes in each stage dir.
+///
+/// Used to locate the `cxg-symbols.db` for cross-repo `dst_id` resolution (ADR-1 points 4-5).
+fn build_repo_stage_map(stage_dirs: &[PathBuf]) -> HashMap<String, PathBuf> {
+    let mut map: HashMap<String, PathBuf> = HashMap::new();
+    for stage_dir in stage_dirs {
+        let shards = match collect_shards(stage_dir, "nodes") {
+            Ok(s) => s,
+            Err(_) => continue,
+        };
+        'outer: for shard_path in &shards {
+            let reader =
+                match parquet::arrow::arrow_reader::ParquetRecordBatchReaderBuilder::try_new(
+                    match std::fs::File::open(shard_path) {
+                        Ok(f) => f,
+                        Err(_) => continue,
+                    },
+                )
+                .and_then(|b| b.build())
+                {
+                    Ok(r) => r,
+                    Err(_) => continue,
+                };
+            for batch_result in reader {
+                let Ok(batch) = batch_result else { continue };
+                let nodes = record_batch_to_nodes(&batch);
+                for node in nodes {
+                    if !node.repo_name.is_empty() {
+                        map.insert(node.repo_name.clone(), stage_dir.to_path_buf());
+                        break 'outer;
+                    }
+                }
+            }
+        }
+    }
+    map
+}
