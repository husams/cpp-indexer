+/// S7-SC-12: visit_tu allocator wiring — nodes emitted via visit_tu with a real allocator
+/// have non-zero symbol_id and file_id (fails if the allocator is not threaded through).
+///
+/// This test calls `visit_tu` with a minimal C++ source and verifies that the
+/// returned nodes carry non-zero integer IDs. It would catch a regression where
+/// `symbol_id` stays at its default-0 stub value.
+#[test]
+fn visit_tu_allocator_wiring() {
+    // Write a minimal C++ file to a temp location.
+    let dir = tempfile::tempdir().unwrap();
+    let src_path = dir.path().join("mini.cpp");
+    std::fs::write(&src_path, b"int add(int a, int b) { return a + b; }\n").unwrap();
+
+    let stage_dir = dir.path().join("stage");
+    std::fs::create_dir_all(&stage_dir).unwrap();
+
+    // Open in-memory allocator.
+    let alloc = Arc::new(SymbolAllocator::open_in_memory(1000).unwrap());
+
+    let clang = global_clang();
+    let opts = VisitOptions {
+        repo_name: "test-repo",
+        tu_hash: [0u8; 32],
+        file_path: &src_path,
+        args: &["clang++".to_owned(), "-std=c++14".to_owned()],
+        skip_system_headers: true,
+        allocator: Some(Arc::clone(&alloc)),
+    };
+
+    let mut writer = StageWriter::new(&stage_dir, 0).unwrap();
+    visit_tu(clang, &opts, &mut writer).unwrap();
+    writer.finish().unwrap();
+
+    // Read back the nodes parquet.
+    let worker_dir = stage_dir.join("worker-000");
+    let nodes_path = std::fs::read_dir(&worker_dir)
+        .unwrap()
+        .filter_map(|e| e.ok())
+        .find(|e| e.file_name().to_string_lossy().starts_with("nodes-"))
+        .expect("nodes parquet must exist")
+        .path();
+
+    let file = std::fs::File::open(&nodes_path).unwrap();
+    let reader = parquet::arrow::arrow_reader::ParquetRecordBatchReaderBuilder::try_new(file)
+        .unwrap()
+        .build()
+        .unwrap();
+    let mut nodes: Vec<cpp_indexer::schema::NodeRecord> = Vec::new();
+    for batch in reader {
+        nodes.extend(record_batch_to_nodes(&batch.unwrap()));
+    }
+
+    assert!(!nodes.is_empty(), "visit_tu must emit at least one node");
+
+    for n in &nodes {
+        assert!(
+            n.symbol_id != 0 || n.kind == cpp_indexer::schema::NodeKind::Module,
+            "non-Module node '{}' must have non-zero symbol_id; got {}",
+            n.usr,
+            n.symbol_id
+        );
+        assert!(
+            n.file_id != 0,
+            "node '{}' must have non-zero file_id; got {}",
+            n.usr,
+            n.file_id
+        );
+    }
+
+    // Run a second time — same USRs must produce the same IDs (C3).
+    let stage2 = dir.path().join("stage2");
+    std::fs::create_dir_all(&stage2).unwrap();
+    let opts2 = VisitOptions {
+        repo_name: "test-repo",
+        tu_hash: [0u8; 32],
+        file_path: &src_path,
+        args: &["clang++".to_owned(), "-std=c++14".to_owned()],
+        skip_system_headers: true,
+        allocator: Some(Arc::clone(&alloc)),
+    };
+    let mut w2 = StageWriter::new(&stage2, 0).unwrap();
+    visit_tu(clang, &opts2, &mut w2).unwrap();
+    w2.finish().unwrap();
+
+    let worker2 = stage2.join("worker-000");
+    let nodes2_path = std::fs::read_dir(&worker2)
+        .unwrap()
+        .filter_map(|e| e.ok())
+        .find(|e| e.file_name().to_string_lossy().starts_with("nodes-"))
+        .expect("nodes parquet must exist on second run")
+        .path();
+    let file2 = std::fs::File::open(&nodes2_path).unwrap();
+    let reader2 = parquet::arrow::arrow_reader::ParquetRecordBatchReaderBuilder::try_new(file2)
+        .unwrap()
+        .build()
+        .unwrap();
+    let mut nodes2: Vec<cpp_indexer::schema::NodeRecord> = Vec::new();
+    for batch in reader2 {
+        nodes2.extend(record_batch_to_nodes(&batch.unwrap()));
+    }
+
+    // Sort by USR for deterministic comparison.
+    let mut run1: Vec<_> = nodes.iter().map(|n| (n.usr.clone(), n.symbol_id)).collect();
+    let mut run2: Vec<_> = nodes2
+        .iter()
+        .map(|n| (n.usr.clone(), n.symbol_id))
+        .collect();
+    run1.sort();
+    run2.sort();
+
+    assert_eq!(
+        run1, run2,
+        "re-index must produce the same symbol_ids for the same USRs (C3)"
+    );
+}
