@@ -0,0 +1,468 @@
+//! Per-repo SQLite symbol/file ID map with write-through LRU cache (Story 1, graph-symbol-ids).
+//!
+//! Provides [`SymbolAllocator`] — a thread-safe, SQLite-backed store that maps
+//! USR strings → integer IDs and file paths → integer IDs. IDs are SQLite rowid
+//! aliases (i64), monotonically increasing from 1, densely allocated.
+//!
+//! # Concurrency
+//! One write `Connection` behind a `std::sync::Mutex`; WAL mode allows concurrent
+//! read-only opens by the read path.  One allocator per repo; one Mutex — no
+//! nesting → deadlock-free.
+//!
+//! # Cache
+//! Bidirectional write-through LRU:
+//! - Forward: `usr → id` and `path → id`.
+//! - Reverse: `id → usr` and `id → path`.
+//!
+//! `cache_size == 0` disables the cache entirely; every lookup hits SQLite.
+//!
+//! # Write-through order
+//! SQLite is written first; the cache is populated after a successful write.
+//! Eviction can therefore never lose data (C5, S2-SC-03).
+
+use std::num::NonZeroUsize;
+use std::path::{Path, PathBuf};
+use std::sync::Mutex;
+
+use lru::LruCache;
+use rusqlite::{params, Connection, OptionalExtension};
+
+use crate::error::{Error, Result};
+
+// ── Internal cache ────────────────────────────────────────────────────────────
+
+struct SymbolCache {
+    /// Forward: usr/path string → id.
+    forward: LruCache<String, i64>,
+    /// Reverse: id → usr/path string.
+    reverse: LruCache<i64, String>,
+}
+
+impl SymbolCache {
+    fn new(capacity: usize) -> Option<Self> {
+        let cap = NonZeroUsize::new(capacity)?;
+        Some(Self {
+            forward: LruCache::new(cap),
+            reverse: LruCache::new(cap),
+        })
+    }
+
+    fn get_forward(&mut self, key: &str) -> Option<i64> {
+        self.forward.get(key).copied()
+    }
+
+    fn get_reverse(&mut self, id: i64) -> Option<&str> {
+        self.reverse.get(&id).map(|s| s.as_str())
+    }
+
+    fn insert(&mut self, key: String, id: i64) {
+        self.reverse.put(id, key.clone());
+        self.forward.put(key, id);
+    }
+}
+
+// ── SymbolAllocator ───────────────────────────────────────────────────────────
+
+/// Thread-safe per-repo SQLite-backed symbol and file ID allocator.
+///
+/// Use [`SymbolAllocator::open`] to create a write-capable instance and
+/// [`SymbolAllocator::open_readonly`] to obtain a read-only resolver handle
+/// for cross-repo or read-path resolution.
+pub struct SymbolAllocator {
+    inner: Mutex<AllocatorInner>,
+}
+
+struct AllocatorInner {
+    conn: Connection,
+    sym_cache: Option<SymbolCache>,
+    file_cache: Option<SymbolCache>,
+}
+
+impl SymbolAllocator {
+    // ── Constructors ──────────────────────────────────────────────────────────
+
+    /// Open (or create) the SQLite database at `path` with a write-capable connection.
+    ///
+    /// `cache_size == 0` disables the LRU cache; every lookup hits SQLite.
+    pub fn open(path: &Path, cache_size: usize) -> Result<Self> {
+        let conn = Connection::open(path).map_err(db_err)?;
+        Self::init_db(&conn)?;
+        Ok(Self {
+            inner: Mutex::new(AllocatorInner {
+                conn,
+                sym_cache: SymbolCache::new(cache_size),
+                file_cache: SymbolCache::new(cache_size),
+            }),
+        })
+    }
+
+    /// Open an **in-memory** SQLite database (useful for tests).
+    pub fn open_in_memory(cache_size: usize) -> Result<Self> {
+        let conn = Connection::open_in_memory().map_err(db_err)?;
+        Self::init_db(&conn)?;
+        Ok(Self {
+            inner: Mutex::new(AllocatorInner {
+                conn,
+                sym_cache: SymbolCache::new(cache_size),
+                file_cache: SymbolCache::new(cache_size),
+            }),
+        })
+    }
+
+    /// Open the SQLite database at `path` as **read-only** (for resolvers).
+    ///
+    /// Still caches forward/reverse lookups; writes are not possible.
+    pub fn open_readonly(path: &Path, cache_size: usize) -> Result<Self> {
+        let flags =
+            rusqlite::OpenFlags::SQLITE_OPEN_READ_ONLY | rusqlite::OpenFlags::SQLITE_OPEN_NO_MUTEX;
+        let conn = Connection::open_with_flags(path, flags).map_err(db_err)?;
+        Ok(Self {
+            inner: Mutex::new(AllocatorInner {
+                conn,
+                sym_cache: SymbolCache::new(cache_size),
+                file_cache: SymbolCache::new(cache_size),
+            }),
+        })
+    }
+
+    fn init_db(conn: &Connection) -> Result<()> {
+        conn.execute_batch(
+            "PRAGMA journal_mode=WAL;
+             PRAGMA synchronous=NORMAL;
+             CREATE TABLE IF NOT EXISTS symbols (
+                 id  INTEGER PRIMARY KEY,
+                 usr TEXT    NOT NULL UNIQUE
+             );
+             CREATE TABLE IF NOT EXISTS files (
+                 id   INTEGER PRIMARY KEY,
+                 path TEXT    NOT NULL UNIQUE
+             );",
+        )
+        .map_err(db_err)
+    }
+
+    // ── Symbol (USR) allocation ───────────────────────────────────────────────
+
+    /// Get the integer ID for `usr`, allocating a new one if needed.
+    ///
+    /// Thread-safe. On concurrent first-insert of the same USR, exactly one
+    /// row is created and both callers receive the same ID (S2-SC-08).
+    pub fn get_or_insert_symbol(&self, usr: &str) -> Result<i64> {
+        let mut inner = self.inner.lock().expect("symbol allocator lock poisoned");
+
+        // Fast path: cache hit.
+        if let Some(cache) = &mut inner.sym_cache {
+            if let Some(id) = cache.get_forward(usr) {
+                return Ok(id);
+            }
+        }
+
+        // Slow path: SQLite insert-or-ignore + select.
+        inner
+            .conn
+            .execute(
+                "INSERT INTO symbols (usr) VALUES (?1) ON CONFLICT(usr) DO NOTHING",
+                params![usr],
+            )
+            .map_err(db_err)?;
+        let id: i64 = inner
+            .conn
+            .query_row(
+                "SELECT id FROM symbols WHERE usr = ?1",
+                params![usr],
+                |row| row.get(0),
+            )
+            .map_err(db_err)?;
+
+        if let Some(cache) = &mut inner.sym_cache {
+            cache.insert(usr.to_owned(), id);
+        }
+        Ok(id)
+    }
+
+    /// Get the integer ID for `path`, allocating a new one if needed.
+    pub fn get_or_insert_file(&self, path: &str) -> Result<i64> {
+        let mut inner = self.inner.lock().expect("symbol allocator lock poisoned");
+
+        if let Some(cache) = &mut inner.file_cache {
+            if let Some(id) = cache.get_forward(path) {
+                return Ok(id);
+            }
+        }
+
+        inner
+            .conn
+            .execute(
+                "INSERT INTO files (path) VALUES (?1) ON CONFLICT(path) DO NOTHING",
+                params![path],
+            )
+            .map_err(db_err)?;
+        let id: i64 = inner
+            .conn
+            .query_row(
+                "SELECT id FROM files WHERE path = ?1",
+                params![path],
+                |row| row.get(0),
+            )
+            .map_err(db_err)?;
+
+        if let Some(cache) = &mut inner.file_cache {
+            cache.insert(path.to_owned(), id);
+        }
+        Ok(id)
+    }
+
+    // ── Reverse resolvers ─────────────────────────────────────────────────────
+
+    /// Resolve a symbol integer `id` back to its USR string.
+    ///
+    /// Returns `Ok(None)` when the ID is not found (stale/missing).
+    pub fn resolve_symbol(&self, id: i64) -> Result<Option<String>> {
+        let mut inner = self.inner.lock().expect("symbol allocator lock poisoned");
+
+        if let Some(cache) = &mut inner.sym_cache {
+            if let Some(usr) = cache.get_reverse(id) {
+                return Ok(Some(usr.to_owned()));
+            }
+        }
+
+        let result: Option<String> = inner
+            .conn
+            .query_row(
+                "SELECT usr FROM symbols WHERE id = ?1",
+                params![id],
+                |row| row.get(0),
+            )
+            .optional()
+            .map_err(db_err)?;
+
+        if let (Some(cache), Some(ref usr)) = (&mut inner.sym_cache, &result) {
+            cache.insert(usr.clone(), id);
+        }
+        Ok(result)
+    }
+
+    /// Resolve a file integer `id` back to its path string.
+    ///
+    /// Returns `Ok(None)` when the ID is not found.
+    pub fn resolve_file(&self, id: i64) -> Result<Option<String>> {
+        let mut inner = self.inner.lock().expect("symbol allocator lock poisoned");
+
+        if let Some(cache) = &mut inner.file_cache {
+            if let Some(path) = cache.get_reverse(id) {
+                return Ok(Some(path.to_owned()));
+            }
+        }
+
+        let result: Option<String> = inner
+            .conn
+            .query_row("SELECT path FROM files WHERE id = ?1", params![id], |row| {
+                row.get(0)
+            })
+            .optional()
+            .map_err(db_err)?;
+
+        if let (Some(cache), Some(ref path)) = (&mut inner.file_cache, &result) {
+            cache.insert(path.clone(), id);
+        }
+        Ok(result)
+    }
+
+    // ── DB path helper ────────────────────────────────────────────────────────
+
+    /// Default SQLite path for a given stage directory.
+    pub fn default_db_path(stage_dir: &Path) -> PathBuf {
+        stage_dir.join("cxg-symbols.db")
+    }
+}
+
+fn db_err(e: rusqlite::Error) -> Error {
+    Error::Io(std::io::Error::other(format!("symbol-map SQLite: {e}")))
+}
+
+// ── Tests ─────────────────────────────────────────────────────────────────────
+
+#[cfg(test)]
+mod tests {
+    use std::sync::Arc;
+
+    use super::*;
+
+    fn alloc(cache: usize) -> SymbolAllocator {
+        SymbolAllocator::open_in_memory(cache).expect("in-memory open")
+    }
+
+    // S7-SC-01: insert new USR → new id + row
+    #[test]
+    fn insert_new_usr_allocates_id() {
+        let a = alloc(100);
+        let id = a.get_or_insert_symbol("c:@F@foo").unwrap();
+        assert!(id > 0);
+        // Verify row exists via resolve.
+        let got = a.resolve_symbol(id).unwrap();
+        assert_eq!(got, Some("c:@F@foo".to_owned()));
+    }
+
+    // S7-SC-02: dup USR → same id, no new row
+    #[test]
+    fn insert_duplicate_usr_same_id() {
+        let a = alloc(100);
+        let id1 = a.get_or_insert_symbol("c:@F@bar").unwrap();
+        let id2 = a.get_or_insert_symbol("c:@F@bar").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-03: insert new path → new id
+    #[test]
+    fn insert_new_path_allocates_id() {
+        let a = alloc(100);
+        let id = a.get_or_insert_file("/src/foo.cpp").unwrap();
+        assert!(id > 0);
+    }
+
+    // S7-SC-04: dup path → same id
+    #[test]
+    fn insert_duplicate_path_same_id() {
+        let a = alloc(100);
+        let id1 = a.get_or_insert_file("/src/foo.cpp").unwrap();
+        let id2 = a.get_or_insert_file("/src/foo.cpp").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-05: persistence across reopen (use tempfile)
+    #[test]
+    fn persistence_across_reopen() {
+        let dir = tempfile::tempdir().unwrap();
+        let path = dir.path().join("test.db");
+        let id1 = {
+            let a = SymbolAllocator::open(&path, 0).unwrap();
+            a.get_or_insert_symbol("c:@F@persist").unwrap()
+        };
+        // Reopen
+        let a2 = SymbolAllocator::open(&path, 0).unwrap();
+        let id2 = a2.get_or_insert_symbol("c:@F@persist").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-06: cache hit (probe by checking that a second call with cache==1 stays consistent)
+    #[test]
+    fn cache_hit_returns_same_id() {
+        let a = alloc(100);
+        let id1 = a.get_or_insert_symbol("c:@F@cached").unwrap();
+        // Second call — must hit cache, return same id.
+        let id2 = a.get_or_insert_symbol("c:@F@cached").unwrap();
+        assert_eq!(id1, id2);
+    }
+
+    // S7-SC-07: cache miss → query + populate
+    #[test]
+    fn cache_miss_populates_cache() {
+        let a = alloc(0); // no cache
+        let id = a.get_or_insert_symbol("c:@F@nocache").unwrap();
+        assert!(id > 0);
+        // With no cache, resolve must hit SQLite each time — both calls must succeed.
+        let r1 = a.resolve_symbol(id).unwrap();
+        let r2 = a.resolve_symbol(id).unwrap();
+        assert_eq!(r1, r2);
+    }
+
+    // S7-SC-08: LRU eviction — size-1 cache evicts on second distinct insert
+    #[test]
+    fn lru_eviction_size_1() {
+        let a = alloc(1);
+        let _id1 = a.get_or_insert_symbol("c:@F@x").unwrap();
+        let _id2 = a.get_or_insert_symbol("c:@F@y").unwrap();
+        // Resolve x — must still work via SQLite (evicted from cache but SQLite holds it).
+        let rx = a.resolve_symbol(_id1).unwrap();
+        assert_eq!(rx, Some("c:@F@x".to_owned()));
+    }
+
+    // S7-SC-09: cache_size=0 disables caching
+    #[test]
+    fn cache_size_zero_disables_cache() {
+        let a = alloc(0);
+        let id = a.get_or_insert_symbol("c:@F@nocache2").unwrap();
+        // Must succeed regardless.
+        let r = a.resolve_symbol(id).unwrap();
+        assert_eq!(r, Some("c:@F@nocache2".to_owned()));
+    }
+
+    // S7-SC-10: id→usr reverse lookup
+    #[test]
+    fn reverse_symbol_lookup() {
+        let a = alloc(100);
+        let id = a.get_or_insert_symbol("c:@F@rev").unwrap();
+        let usr = a.resolve_symbol(id).unwrap();
+        assert_eq!(usr, Some("c:@F@rev".to_owned()));
+    }
+
+    // S7-SC-11: id→path reverse lookup
+    #[test]
+    fn reverse_file_lookup() {
+        let a = alloc(100);
+        let id = a.get_or_insert_file("/src/rev.cpp").unwrap();
+        let path = a.resolve_file(id).unwrap();
+        assert_eq!(path, Some("/src/rev.cpp".to_owned()));
+    }
+
+    // S2-SC-08: concurrent same-usr → exactly one id
+    #[test]
+    fn concurrent_same_usr_one_id() {
+        let a = Arc::new(alloc(0));
+        let handles: Vec<_> = (0..8)
+            .map(|_| {
+                let a = Arc::clone(&a);
+                std::thread::spawn(move || a.get_or_insert_symbol("c:@C@Widget").unwrap())
+            })
+            .collect();
+        let ids: Vec<i64> = handles.into_iter().map(|h| h.join().unwrap()).collect();
+        let first = ids[0];
+        assert!(
+            ids.iter().all(|&id| id == first),
+            "all threads must get the same id"
+        );
+    }
+
+    // S2-SC-09: concurrent distinct usrs → distinct ids
+    #[test]
+    fn concurrent_distinct_usrs_distinct_ids() {
+        let a = Arc::new(alloc(0));
+        let handles: Vec<_> = (0..8)
+            .map(|i| {
+                let a = Arc::clone(&a);
+                std::thread::spawn(move || {
+                    a.get_or_insert_symbol(&format!("c:@C@Type{i}")).unwrap()
+                })
+            })
+            .collect();
+        let mut ids: Vec<i64> = handles.into_iter().map(|h| h.join().unwrap()).collect();
+        ids.sort_unstable();
+        ids.dedup();
+        assert_eq!(ids.len(), 8, "distinct usrs must produce distinct ids");
+    }
+
+    // S2-SC-10: N≥8 threads allocate concurrently, no deadlock/panic
+    #[test]
+    fn parallel_allocation_no_deadlock() {
+        let a = Arc::new(alloc(1_000));
+        std::thread::scope(|s| {
+            for i in 0..16 {
+                let a = Arc::clone(&a);
+                s.spawn(move || {
+                    for j in 0..50 {
+                        a.get_or_insert_symbol(&format!("c:@F@fn_{i}_{j}")).unwrap();
+                        a.get_or_insert_file(&format!("/src/file_{i}.cpp")).unwrap();
+                    }
+                });
+            }
+        });
+    }
+
+    // Missing ID on read returns None (not an error)
+    #[test]
+    fn resolve_missing_id_returns_none() {
+        let a = alloc(100);
+        let r = a.resolve_symbol(99999).unwrap();
+        assert_eq!(r, None);
+    }
+}
