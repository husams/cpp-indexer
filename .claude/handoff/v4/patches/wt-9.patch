+/// Write-path schema version gate (ADR-4, S6-SC-01/02, adr-4 follow-up i).
+///
+/// Called by the indexer **before** any Phase 4/6 write. Refuses to append
+/// data when the graph was written by a different schema version, requiring
+/// the operator to run `reset` and re-index.
+///
+/// - `None` (fresh / empty DB) → allowed; Phase 4 will write the version node.
+/// - Matching version → allowed.
+/// - Mismatching version → `Error::Schema` with explicit reset instruction.
+///
+/// This is intentionally separate from `check_schema_version` (Phase 5 read
+/// gate) so that the reset-instruction message can be distinct without
+/// perturbing Phase 5 callers.
+pub async fn check_write_path_schema_version(sink: &Arc<dyn GraphSink>) -> Result<()> {
+    match sink.read_schema_version().await? {
+        None => {
+            // Fresh DB — no existing data to corrupt; write is safe.
+            info!("write-path version gate: no SchemaVersion node found; proceeding");
+            Ok(())
+        }
+        Some(actual) => {
+            if actual != SCHEMA_VERSION_TAG {
+                Err(Error::Schema(format!(
+                    "write-path schema version mismatch: binary expects '{SCHEMA_VERSION_TAG}', \
+                     graph reports '{actual}'. \
+                     To upgrade: stop all writers, run `cxg-index --reset`, then re-index. \
+                     Aborting to prevent silent data corruption."
+                )))
+            } else {
+                info!("write-path version gate: schema version OK ({actual})");
+                Ok(())
+            }
+        }
+    }
+}
